<section class="section account-page">
  <div class="page-width">
    <a href="{{ routes.account_url }}" class="link-arrow">{% render 'icon', icon: 'arrow', class: 'icon--flip' %} {{ 'customer.account.return' | t }}</a>
    <h1 class="display account-page__title">{{ 'customer.addresses.title' | t }}</h1>

    {%- paginate customer.addresses by 10 -%}
      <div class="addresses">
        {%- for address in customer.addresses -%}
          <div class="address-card">
            {%- if address == customer.default_address -%}<span class="badge badge--accent">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
            <address class="account-page__address">{{ address | format_address }}</address>
            <details class="accordion">
              <summary class="accordion__summary"><span class="accordion__title">{{ 'customer.addresses.edit' | t }}</span>{% render 'icon', icon: 'plus', class: 'accordion__toggle' %}</summary>
              <div class="accordion__content">
                {%- form 'customer_address', address, class: 'form' -%}
                  {%- render 'address-fields', form: form, id: address.id -%}
                  <button type="submit" class="btn btn--primary">{{ 'customer.addresses.update' | t }}</button>
                {%- endform -%}
                <form method="post" action="{{ address.url }}" class="address-card__delete" data-confirm="{{ 'customer.addresses.delete_confirm' | t | escape }}">
                  <input type="hidden" name="_method" value="delete">
                  <button type="submit" class="btn btn--ghost btn--sm">{{ 'customer.addresses.delete' | t }}</button>
                </form>
              </div>
            </details>
          </div>
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}

    <details class="accordion address-new" {% if customer.addresses_count == 0 %}open{% endif %}>
      <summary class="accordion__summary"><span class="accordion__title">{{ 'customer.addresses.add' | t }}</span>{% render 'icon', icon: 'plus', class: 'accordion__toggle' %}</summary>
      <div class="accordion__content">
        {%- form 'customer_address', customer.new_address, class: 'form' -%}
          {%- render 'address-fields', form: form, id: 'new' -%}
          <button type="submit" class="btn btn--primary">{{ 'customer.addresses.add' | t }}</button>
        {%- endform -%}
      </div>
    </details>
  </div>
</section>

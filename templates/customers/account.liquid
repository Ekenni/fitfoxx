<section class="section account-page">
  <div class="page-width">
    <div class="account-page__head">
      <div>
        <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
        <h1 class="display account-page__title">{{ customer.first_name | default: customer.name }}</h1>
      </div>
      <a href="{{ routes.account_logout_url }}" class="btn btn--outline">{{ 'customer.account.logout' | t }}</a>
    </div>
    <div class="account-page__grid">
      <div>
        <h2 class="h3">{{ 'customer.orders.title' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="table-wrap">
              <table class="size-table">
                <thead><tr><th>{{ 'customer.orders.order' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.status' | t }}</th><th>{{ 'general.cart.total' | t }}</th></tr></thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                      <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td>{{ order.total_price | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            {%- render 'pagination', paginate: paginate -%}
          {%- else -%}
            <p>{{ 'customer.orders.none' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.continue_shopping' | t }}</a>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <aside>
        <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
        {%- if customer.default_address -%}
          <address class="account-page__address">{{ customer.default_address | format_address }}</address>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="link-arrow">{{ 'customer.addresses.view' | t: count: customer.addresses_count }} {% render 'icon', icon: 'arrow' %}</a>
      </aside>
    </div>
  </div>
</section>

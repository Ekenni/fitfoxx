<section class="section account-page">
  <div class="page-width account-page__narrow">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="display account-page__title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form__row">
        <label class="field"><span class="field__label">{{ 'customer.register.first_name' | t }}</span><input class="field__input" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}"></label>
        <label class="field"><span class="field__label">{{ 'customer.register.last_name' | t }}</span><input class="field__input" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}"></label>
      </div>
      <label class="field"><span class="field__label">{{ 'templates.contact.form.email' | t }}</span><input class="field__input" type="email" name="customer[email]" autocomplete="email" value="{{ form.email }}" required></label>
      <label class="field"><span class="field__label">{{ 'customer.login.password' | t }}</span><input class="field__input" type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="facet__check"><input type="checkbox" name="customer[accepts_marketing]" value="true"><span class="facet__box" aria-hidden="true">{% render 'icon', icon: 'check' %}</span><span class="facet__label">{{ 'customer.register.marketing' | t }}</span></label>
      <button type="submit" class="btn btn--primary btn--block">{{ 'customer.register.submit' | t }}</button>
      <a href="{{ routes.account_login_url }}" class="link-arrow">{{ 'customer.register.have_account' | t }}</a>
    {%- endform -%}
  </div>
</section>

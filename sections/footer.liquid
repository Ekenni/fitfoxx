<footer class="footer" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo">
          {%- render 'logo-full', class: 'footer__logo-img' -%}
          <span class="visually-hidden">{{ shop.name }}</span>
        </a>
        {%- if section.settings.brand_text != blank -%}
          <div class="footer__brand-text rte">{{ section.settings.brand_text }}</div>
        {%- endif -%}
        {%- if section.settings.show_social -%}{%- render 'social-icons', class: 'footer__social' -%}{%- endif -%}
      </div>

      <div class="footer__blocks">
        {%- for block in section.blocks -%}
          <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading }}</h2>{%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading }}</h2>{%- endif -%}
                <div class="rte footer__text">{{ block.settings.text }}</div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_wordmark -%}
      <div class="footer__giant" aria-hidden="true">
        <span>{{ section.settings.wordmark_text }}</span>
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}. {{ powered_by_link }}</p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if shop.policies.size > 0 -%}
        <ul class="footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "settings": [
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand text",
      "default": "<p>Performance apparel built for the ones who train when nobody's watching.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Add links in Theme settings > Social media",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show oversized wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Oversized wordmark text",
      "default": "FOXX"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright name",
      "default": "FitFoxx Athletics"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Customer service" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about sizing, orders or returns? Our team replies within 24 hours.</p>" }
      ]
    }
  ]
}
{% endschema %}

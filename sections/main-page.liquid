<section class="section page-content" {{ section.shopify_attributes }}>
  <div class="page-width page-content__inner">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="display page-content__title">{{ page.title }}</h1>
    <div class="rte page-content__body">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}

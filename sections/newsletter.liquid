{%- assign s = section.settings -%}
<section class="section newsletter newsletter--{{ s.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width newsletter__inner">
    <div class="newsletter__intro">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="newsletter__heading display">{{ s.heading }}</h2>{%- endif -%}
    </div>
    <div class="newsletter__body">
      {%- if s.text != blank -%}<div class="newsletter__text rte">{{ s.text }}</div>{%- endif -%}
      {%- assign newsletter_id = 'NewsletterForm-' | append: section.id -%}
      {%- form 'customer', id: newsletter_id, class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{% render 'icon', icon: 'check' %} {{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="newsletter__field">
            <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="{{ 'newsletter.label' | t }}"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}
            >
            <button type="submit" class="btn btn--inverse">{{ s.button_label | default: 'Sign up' }} {% render 'icon', icon: 'arrow' %}</button>
          </div>
          {%- if form.errors -%}
            <p class="form-message form-message--error" id="NewsletterError-{{ section.id }}" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
      {%- if s.fine_print != blank -%}<p class="newsletter__fine">{{ s.fine_print }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "paragraph", "content": "Sign-ups are saved as customers in Shopify Admin with the tag \"newsletter\" and marketing consent." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Den" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the pack" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Early access to drops, training notes and members-only offers.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" },
    { "type": "text", "id": "fine_print", "label": "Fine print" },
    {
      "type": "select", "id": "color_scheme", "label": "Background",
      "options": [
        { "value": "light", "label": "Off-white" },
        { "value": "charcoal", "label": "Charcoal" },
        { "value": "accent", "label": "Accent green" }
      ],
      "default": "light"
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

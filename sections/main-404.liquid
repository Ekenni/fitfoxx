<section class="section not-found" {{ section.shopify_attributes }}>
  {%- render 'icon-fox', class: 'not-found__mark' -%}
  <div class="page-width not-found__inner">
    <p class="eyebrow">{{ 'templates.404.eyebrow' | t }}</p>
    <h1 class="display not-found__title">404</h1>
    <p class="not-found__text">{{ 'templates.404.text' | t }}</p>
    <div class="not-found__actions">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ 'general.continue_shopping' | t }} {% render 'icon', icon: 'arrow' %}</a>
      <a href="{{ routes.search_url }}" class="btn btn--ghost btn--lg">{{ 'general.search.title' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "class": "section-404",
  "settings": []
}
{% endschema %}

{%- liquid
  assign count = section.blocks.size
-%}
{%- if count > 0 -%}
  <div class="announcement announcement--{{ section.settings.style }} announcement--{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} data-announcement data-interval="{{ section.settings.interval }}">
    {%- if section.settings.style == 'marquee' -%}
      <div class="announcement__marquee" aria-label="{{ 'sections.announcement.label' | t }}">
        {%- for i in (1..2) -%}
          <div class="announcement__track"{% if i == 2 %} aria-hidden="true"{% endif %}>
            {%- for loop in (1..3) -%}
              {%- for block in section.blocks -%}
                <span class="announcement__item">
                  {%- if block.settings.link != blank and i == 1 and loop == 1 -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </span>
                <span class="announcement__sep" aria-hidden="true"></span>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="announcement__slides page-width" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
        {%- for block in section.blocks -%}
          <p class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} data-announcement-slide>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }} {% render 'icon', icon: 'arrow' %}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "rotate", "label": "Rotating messages" },
        { "value": "marquee", "label": "Scrolling ticker" }
      ],
      "default": "rotate"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color",
      "options": [
        { "value": "dark", "label": "Charcoal" },
        { "value": "light", "label": "Off-white" },
        { "value": "accent", "label": "Accent green" }
      ],
      "default": "dark"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Rotation speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $75" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}

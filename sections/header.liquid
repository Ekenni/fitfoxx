{%- liquid
  assign menu = section.settings.menu
  assign logo_width = section.settings.logo_width
-%}
<header class="header{% if section.settings.sticky %} header--sticky{% endif %}" style="--header-bg: {{ section.settings.background | default: '#000000' }}" data-header {{ section.shopify_attributes }}>
  <div class="header__inner page-width">
    <button type="button" class="header__icon header__burger" aria-controls="MobileMenu" aria-expanded="false" data-menu-open>
      {%- render 'icon', icon: 'menu' -%}
      <span class="visually-hidden">{{ 'general.menu.open' | t }}</span>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo" style="--logo-width: {{ logo_width }}px">
      {%- render 'logo', width: logo_width, class: 'header__logo-img' -%}
    </a>

    {%- if menu != blank -%}
      <nav class="header__nav" aria-label="{{ 'general.menu.primary' | t }}">
        <ul class="nav" role="list">
          {%- for link in menu.links -%}
            <li class="nav__item{% if link.links != blank %} nav__item--has-children{% endif %}">
              <a href="{{ link.url }}" class="nav__link{% if link.active or link.child_active %} is-active{% endif %}"{% if link.links != blank %} aria-haspopup="true"{% endif %}>
                {{ link.title }}
                {%- if link.links != blank %}{% render 'icon', icon: 'chevron' %}{% endif -%}
              </a>
              {%- if link.links != blank -%}
                <div class="mega">
                  <div class="mega__inner page-width">
                    <p class="mega__label">{{ link.title }}</p>
                    <ul class="mega__cols" role="list">
                      {%- for child in link.links -%}
                        <li class="mega__col">
                          <a href="{{ child.url }}" class="mega__heading">{{ child.title }}</a>
                          {%- if child.links != blank -%}
                            <ul class="mega__list" role="list">
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                    <a href="{{ link.url }}" class="mega__all link-arrow">{{ 'general.menu.shop_all' | t: title: link.title }} {% render 'icon', icon: 'arrow' %}</a>
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="header__icon" data-search-open aria-controls="SearchPanel" aria-expanded="false">
        {%- render 'icon', icon: 'search' -%}
        <span class="visually-hidden">{{ 'general.search.title' | t }}</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header__icon header__icon--account">
          {%- render 'icon', icon: 'account' -%}
          <span class="visually-hidden">{{ 'customer.account.title' | t }}</span>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__icon header__cart">
        {%- render 'icon', icon: 'cart' -%}
        <span class="visually-hidden">{{ 'general.cart.title' | t }}</span>
        {%- if cart.item_count > 0 -%}
          <span class="header__count" aria-label="{{ 'general.cart.item_count' | t: count: cart.item_count }}">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="search-panel" id="SearchPanel" data-search-panel hidden>
    <div class="page-width search-panel__inner">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form">
        <label for="HeaderSearch" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
        {%- render 'icon', icon: 'search' -%}
        <input type="search" id="HeaderSearch" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" data-predictive-input>
        <input type="hidden" name="options[prefix]" value="last">
        <button type="button" class="header__icon" data-search-close>
          {%- render 'icon', icon: 'close' -%}
          <span class="visually-hidden">{{ 'general.search.close' | t }}</span>
        </button>
      </form>
      <div class="predictive" data-predictive-results aria-live="polite"></div>
    </div>
  </div>
</header>

<div class="mobile-menu" id="MobileMenu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__overlay" data-menu-close></div>
  <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.menu.label' | t }}">
    <div class="mobile-menu__top">
      <a href="{{ routes.root_url }}" class="mobile-menu__logo">{%- render 'logo-wordmark', class: 'mobile-menu__logo-img' -%}<span class="visually-hidden">{{ shop.name }}</span></a>
      <button type="button" class="header__icon" data-menu-close>
        {%- render 'icon', icon: 'close' -%}
        <span class="visually-hidden">{{ 'general.menu.close' | t }}</span>
      </button>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="mobile-menu__search">
      <label for="MobileSearch" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
      <input type="search" id="MobileSearch" name="q" placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="header__icon">{% render 'icon', icon: 'search' %}<span class="visually-hidden">{{ 'general.search.submit' | t }}</span></button>
    </form>
    {%- if menu != blank -%}
      <nav aria-label="{{ 'general.menu.primary' | t }}">
        <ul class="mobile-nav" role="list">
          {%- for link in menu.links -%}
            <li class="mobile-nav__item">
              {%- if link.links != blank -%}
                <details class="mobile-nav__details">
                  <summary class="mobile-nav__link">
                    <span><span class="mobile-nav__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ link.title }}</span>
                    {%- render 'icon', icon: 'plus' -%}
                  </summary>
                  <ul class="mobile-nav__sub" role="list">
                    <li><a href="{{ link.url }}">{{ 'general.menu.shop_all' | t: title: link.title }}</a></li>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                      {%- for grandchild in child.links -%}
                        <li class="mobile-nav__grand"><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                      {%- endfor -%}
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="mobile-nav__link">
                  <span><span class="mobile-nav__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ link.title }}</span>
                  {%- render 'icon', icon: 'arrow' -%}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    <div class="mobile-menu__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-menu__util">{% render 'icon', icon: 'account' %} {% if customer %}{{ 'customer.account.title' | t }}{% else %}{{ 'customer.login.title' | t }}{% endif %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="mobile-menu__util">{% render 'icon', icon: 'cart' %} {{ 'general.cart.title' | t }} ({{ cart.item_count }})</a>
      {%- render 'social-icons' -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    }
  ]
}
{% endschema %}

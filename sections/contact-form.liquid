<section class="section contact" {{ section.shopify_attributes }}>
  <div class="page-width contact__inner">
    <div>
      {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte contact__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    {%- assign contact_id = 'ContactForm-' | append: section.id -%}
    {%- form 'contact', id: contact_id, class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{% render 'icon', icon: 'check' %} {{ 'templates.contact.form.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form__row">
        <label class="field"><span class="field__label">{{ 'templates.contact.form.name' | t }}</span><input class="field__input" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></label>
        <label class="field"><span class="field__label">{{ 'templates.contact.form.email' | t }} *</span><input class="field__input" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></label>
      </div>
      <label class="field"><span class="field__label">{{ 'templates.contact.form.phone' | t }}</span><input class="field__input" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
      <label class="field"><span class="field__label">{{ 'templates.contact.form.message' | t }}</span><textarea class="field__input" name="contact[body]" rows="6">{{ form.body }}</textarea></label>
      <button type="submit" class="btn btn--primary">{{ 'templates.contact.form.send' | t }} {% render 'icon', icon: 'arrow' %}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to the pack" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Sizing questions, order help or collabs — drop us a line and we'll get back within 24 hours.</p>" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}

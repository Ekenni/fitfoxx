{%- liquid
  assign s = section.settings
  assign c = s.collection
  if c == blank and s.auto_handle != blank
    assign auto_c = collections[s.auto_handle]
    if auto_c.products_count > 0
      assign c = auto_c
    endif
  endif
  assign use_all = false
  if c == blank and collections.all.products_count > 0
    assign c = collections.all
    assign use_all = true
  endif
  assign limit = s.products_to_show
  if c != blank
    if use_all and s.fallback_order == 'newest'
      assign product_list = c.products | sort: 'created_at' | reverse
    else
      assign product_list = c.products
    endif
  endif
-%}
<section class="section featured featured--{{ s.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h1 section-head__title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="section-head__text">{{ s.text }}</div>{%- endif -%}
      </div>
      {%- if s.show_view_all -%}
        <a href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="link-arrow section-head__link">{{ s.view_all_label | default: 'View all' }} {% render 'icon', icon: 'arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="product-grid product-grid--{{ s.layout }}" style="--cols: {{ s.columns }}">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in product_list limit: limit -%}
          {%- render 'product-card', product: product, index: forloop.index0 -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {%- render 'product-card-placeholder', index: i -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "02 — Most wanted" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "richtext", "id": "text", "label": "Description" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "auto_handle", "label": "Auto-match collection handle", "info": "Used when no collection is picked. E.g. best-sellers or new-arrivals. If that collection doesn't exist, all store products are shown." },
    {
      "type": "select", "id": "fallback_order", "label": "Order when showing all products",
      "options": [
        { "value": "default", "label": "Store default" },
        { "value": "newest", "label": "Newest first" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    {
      "type": "select", "id": "columns", "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "scroll", "label": "Horizontal scroll" }
      ],
      "default": "grid"
    },
    {
      "type": "select", "id": "color_scheme", "label": "Background",
      "options": [
        { "value": "dark", "label": "Matte black" },
        { "value": "charcoal", "label": "Charcoal" }
      ],
      "default": "dark"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}

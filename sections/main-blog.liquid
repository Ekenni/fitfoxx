<section class="section blog" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ 'blogs.eyebrow' | t }}</p>
        <h1 class="display">{{ blog.title }}</h1>
      </div>
    </div>
    {%- paginate blog.articles by 9 -%}
      <div class="articles">
        {%- for article in blog.articles -%}
          <article class="article-card reveal">
            <a href="{{ article.url }}" class="article-card__media ratio ratio--landscape">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 700, 1000', alt: article.title }}
              {%- else -%}
                {%- render 'placeholder' -%}
              {%- endif -%}
            </a>
            <p class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="h4 article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </article>
        {%- else -%}
          <p>{{ 'blogs.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}

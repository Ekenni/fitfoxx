{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign featured = current_variant.featured_media | default: product.featured_media
  assign has_only_default = product.has_only_default_variant
-%}
<section class="product-page" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" {{ section.shopify_attributes }}>
  <div class="page-width product">
    <nav class="breadcrumbs product__breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    {%- comment -%} Gallery {%- endcomment -%}
    <div class="product__gallery">
      {%- if product.media.size > 0 -%}
        <ul class="gallery gallery--{{ section.settings.gallery_layout }}" role="list" data-gallery>
          {%- if featured -%}
            <li class="gallery__item is-featured" data-media-id="{{ featured.id }}">
              {%- render 'product-media', media: featured, loading: 'eager', zoom: section.settings.enable_zoom -%}
            </li>
          {%- endif -%}
          {%- for media in product.media -%}
            {%- unless media.id == featured.id -%}
              <li class="gallery__item" data-media-id="{{ media.id }}">
                {%- render 'product-media', media: media, loading: 'lazy', zoom: section.settings.enable_zoom -%}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
        {%- if product.media.size > 1 -%}
          <div class="gallery__counter" aria-hidden="true"><span data-gallery-current>1</span> / {{ product.media.size }}</div>
        {%- endif -%}
      {%- else -%}
        <div class="gallery gallery--empty"><div class="ratio ratio--portrait">{% render 'placeholder', label: 'Product image' %}</div></div>
      {%- endif -%}
    </div>

    {%- comment -%} Info {%- endcomment -%}
    <div class="product__info">
      <div class="product__info-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'eyebrow' -%}
              <div class="product__eyebrow" {{ block.shopify_attributes }}>
                {%- render 'badges', product: product -%}
                {%- if block.settings.text != blank -%}<span class="eyebrow">{{ block.settings.text }}</span>{%- endif -%}
              </div>

            {%- when 'title' -%}
              <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {%- render 'price', product: product, variant: current_variant, class: 'price--lg' -%}
                {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                  <p class="product__tax">
                    {%- if cart.taxes_included -%}{{ 'products.product.tax_included' | t }}{%- endif -%}
                    {%- if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}">{{ 'products.product.shipping_calculated' | t }}</a>{%- endif -%}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless has_only_default -%}
                <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- assign opt_name = option.name | downcase -%}
                    {%- assign is_color = false -%}
                    {%- if opt_name == 'color' or opt_name == 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
                    {%- assign is_size = false -%}
                    {%- if opt_name == 'size' -%}{%- assign is_size = true -%}{%- endif -%}
                    <fieldset class="option{% if is_color %} option--color{% endif %}" data-option-index="{{ forloop.index0 }}">
                      <legend class="option__legend">
                        <span>{{ option.name }}: <strong data-option-selected>{{ option.selected_value }}</strong></span>
                        {%- if is_size and section.settings.show_size_guide -%}
                          <button type="button" class="option__guide" data-size-guide-open aria-controls="SizeGuide-{{ section.id }}">{% render 'icon', icon: 'ruler' %} {{ 'products.product.size_guide' | t }}</button>
                        {%- endif -%}
                      </legend>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                          <input
                            type="radio"
                            class="option__input visually-hidden"
                            id="Option-{{ input_id }}"
                            name="option-{{ section.id }}-{{ forloop.parentloop.index0 }}"
                            value="{{ value | escape }}"
                            {% if value.selected %}checked{% endif %}
                          >
                          {%- if is_color -%}
                            {%- liquid
                              assign swatch_style = ''
                              if value.swatch.image
                                assign swatch_url = value.swatch.image | image_url: width: 80
                                assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                              elsif value.swatch.color
                                assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                              else
                                assign css_color = value | handle | remove: '-'
                                assign swatch_style = 'background-color: ' | append: css_color | append: ';'
                              endif
                            -%}
                            <label for="Option-{{ input_id }}" class="swatch" title="{{ value | escape }}">
                              <span class="swatch__chip" style="{{ swatch_style }}"></span>
                              <span class="visually-hidden">{{ value }}</span>
                            </label>
                          {%- else -%}
                            <label for="Option-{{ input_id }}" class="pill">{{ value }}</label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json" data-variants-json>
                    [{%- for v in product.variants -%}
                      {"id":{{ v.id }},"available":{{ v.available | json }},"options":{{ v.options | json }},"price":{{ v.price | money | json }},"compare":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},"media":{% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %},"sku":{{ v.sku | json }}}{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}]
                  </script>
                </div>
              {%- endunless -%}

            {%- when 'size_guide' -%}
              {%- if has_only_default or section.settings.show_size_guide == false -%}
                <button type="button" class="link-arrow product__guide-link" data-size-guide-open aria-controls="SizeGuide-{{ section.id }}" {{ block.shopify_attributes }}>{% render 'icon', icon: 'ruler' %} {{ 'products.product.size_guide' | t }}</button>
              {%- endif -%}

            {%- when 'quantity' -%}
              <div class="product__qty" {{ block.shopify_attributes }}>
                <label for="Quantity-{{ section.id }}" class="option__legend">{{ 'products.product.quantity' | t }}</label>
                <div class="qty" data-qty>
                  <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.product.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
                  <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric" form="{{ form_id }}" class="qty__input">
                  <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.product.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="product-form__error" role="alert" data-form-error hidden></div>
                  <button type="submit" name="add" class="btn btn--primary btn--lg btn--block product-form__submit" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                    <span data-add-label>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                    {% render 'icon', icon: 'arrow' %}
                  </button>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="product-form__dynamic">{{ form | payment_button }}</div>
                  {%- endif -%}
                {%- endform -%}
                {%- if block.settings.reassurance != blank -%}
                  <p class="product__reassure">{% render 'icon', icon: 'truck' %} {{ block.settings.reassurance }}</p>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'collapsible_tab' -%}
              {%- liquid
                assign tab_content = block.settings.content
                if block.settings.page != blank
                  assign tab_content = block.settings.page.content
                endif
              -%}
              {%- if tab_content != blank -%}
                <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="accordion__summary">
                    <span class="accordion__title">{% render 'icon', icon: block.settings.icon %} {{ block.settings.heading }}</span>
                    {%- render 'icon', icon: 'plus', class: 'accordion__toggle' -%}
                  </summary>
                  <div class="accordion__content rte">{{ tab_content }}</div>
                </details>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Size guide dialog {%- endcomment -%}
  <dialog class="modal" id="SizeGuide-{{ section.id }}" data-size-guide aria-labelledby="SizeGuideTitle-{{ section.id }}">
    <div class="modal__inner">
      <div class="modal__head">
        <h2 class="h3" id="SizeGuideTitle-{{ section.id }}">{{ 'products.product.size_guide' | t }}</h2>
        <button type="button" class="header__icon" data-modal-close>{% render 'icon', icon: 'close' %}<span class="visually-hidden">{{ 'general.menu.close' | t }}</span></button>
      </div>
      <div class="modal__body rte">
        {%- if section.settings.size_guide_page != blank -%}
          {{ section.settings.size_guide_page.content }}
        {%- else -%}
          {%- render 'size-guide-table' -%}
        {%- endif -%}
      </div>
    </div>
  </dialog>

  {%- comment -%} Sticky add to cart (mobile) {%- endcomment -%}
  {%- if section.settings.sticky_atc -%}
    <div class="sticky-atc" data-sticky-atc aria-hidden="true">
      <div class="sticky-atc__info">
        <p class="sticky-atc__title">{{ product.title }}</p>
        <p class="sticky-atc__meta"><span data-sticky-variant>{% unless has_only_default %}{{ current_variant.title }}{% endunless %}</span> <span data-sticky-price>{{ current_variant.price | money }}</span></p>
      </div>
      <button type="submit" form="{{ form_id }}" class="btn btn--primary sticky-atc__btn" data-sticky-button tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
        <span data-add-label>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
      </button>
    </div>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "settings": [
    {
      "type": "select", "id": "gallery_layout", "label": "Desktop gallery",
      "options": [
        { "value": "editorial", "label": "Editorial (large first image + grid)" },
        { "value": "stack", "label": "Single column stack" }
      ],
      "default": "editorial"
    },
    { "type": "checkbox", "id": "enable_zoom", "label": "Open images full size on click", "default": true },
    { "type": "checkbox", "id": "sticky_atc", "label": "Sticky add to cart on mobile", "default": true },
    { "type": "header", "content": "Size guide" },
    { "type": "checkbox", "id": "show_size_guide", "label": "Show size guide link next to size option", "default": true },
    { "type": "page", "id": "size_guide_page", "label": "Size guide page", "info": "Optional. Uses the built-in FOXX size chart when empty." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "eyebrow", "name": "Badges & eyebrow", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Eyebrow text", "default": "FitFoxx Athletics" }] },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "size_guide", "name": "Size guide link", "limit": 1, "settings": [{ "type": "paragraph", "content": "Shown here only when the size guide link is not shown next to the size option." }] },
    { "type": "quantity", "name": "Quantity selector", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "info": "Shows Shop Pay, Apple Pay, PayPal and other accelerated checkouts enabled in your store.", "default": true },
        { "type": "text", "id": "reassurance", "label": "Reassurance text", "default": "Free shipping over $75 · Free 30-day returns" }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible_tab", "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details & materials" },
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "feather", "label": "Fabric" },
            { "value": "ruler", "label": "Fit" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "drop", "label": "Care" },
            { "value": "shield", "label": "Guarantee" }
          ],
          "default": "feather"
        },
        { "type": "richtext", "id": "content", "label": "Content", "info": "Connect a product metafield with the dynamic source button to show product-specific details." },
        { "type": "page", "id": "page", "label": "Content from page", "info": "Overrides the text above" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text block</p>" }] }
  ]
}
{% endschema %}

<section class="password-page">
  {%- render 'icon-fox', class: 'password-page__mark' -%}
  <div class="password-page__inner">
    <div class="password-page__logo">{%- render 'logo-full', class: 'password-page__logo-img', loading: 'eager' -%}<span class="visually-hidden">{{ shop.name }}</span></div>
    <h1 class="display password-page__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="password-page__msg">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form password-page__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prospect">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required autocomplete="email">
          <button type="submit" class="btn btn--primary">{{ 'newsletter.notify' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <details class="password-page__login">
      <summary>{{ 'templates.password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'password-page__pw' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label for="StorePassword" class="visually-hidden">{{ 'templates.password.label' | t }}</label>
        <input type="password" id="StorePassword" name="password" placeholder="{{ 'templates.password.label' | t }}" class="field__input" autocomplete="current-password">
        <button type="submit" class="btn btn--outline">{{ 'templates.password.enter' | t }}</button>
      {%- endform -%}
      <p class="password-page__admin">{{ 'templates.password.admin_link_html' | t }}</p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something's coming" }
  ]
}
{% endschema %}

{%- liquid
  assign s = section.settings
  assign form_id = 'FacetForm-' | append: section.id
  assign has_filters = false
  if s.enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif
  assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
-%}
<section class="collection-page" data-collection {{ section.shopify_attributes }}>
  <header class="collection-hero{% if s.show_image and collection.image %} collection-hero--image{% endif %}">
    {%- if s.show_image and collection.image -%}
      <div class="collection-hero__media">
        {{ collection.image | image_url: width: 2000 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 2000', alt: collection.title }}
      </div>
    {%- endif -%}
    <div class="page-width collection-hero__inner">
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
        <a href="{{ routes.collections_url }}">{{ 'collections.general.title' | t }}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{{ collection.title }}</span>
      </nav>
      <h1 class="display collection-hero__title">{{ collection.title }}</h1>
      {%- if s.show_description and collection.description != blank -%}
        <div class="collection-hero__desc rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </header>

  <div class="page-width">
    {%- paginate collection.products by s.products_per_page -%}
      {%- if s.enable_sorting or has_filters -%}
        {%- render 'collection-toolbar', results: collection, form_id: form_id, count: collection.products_count, clear_url: clear_url, show_filter: has_filters, show_sort: s.enable_sorting -%}
      {%- endif -%}

      <div class="collection-layout{% if has_filters %} collection-layout--filters{% endif %}">
        {%- if has_filters -%}
          <aside class="collection-layout__aside" data-facets-drawer>
            <div class="facets-overlay" data-facets-close></div>
            {%- render 'facets', results: collection, url: collection.url, form_id: form_id -%}
          </aside>
        {%- elsif s.enable_sorting -%}
          <form id="{{ form_id }}" action="{{ collection.url }}" method="get" hidden data-facets-form></form>
        {%- endif -%}

        <div class="collection-layout__main">
          {%- if collection.products.size > 0 -%}
            <div class="product-grid" style="--cols: {{ s.columns }}">
              {%- for product in collection.products -%}
                {%- render 'product-card', product: product, index: forloop.index0 -%}
              {%- endfor -%}
            </div>
            {%- render 'pagination', paginate: paginate -%}
          {%- else -%}
            <div class="empty">
              {%- render 'icon-fox', class: 'empty__mark' -%}
              <h2 class="h3">{{ 'collections.general.empty' | t }}</h2>
              {%- if collection.filters.size > 0 -%}
                <a href="{{ clear_url }}" class="btn btn--outline">{{ 'collections.filters.clear_all' | t }}</a>
              {%- else -%}
                <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.continue_shopping' | t }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "class": "section-main-collection",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Show collection image", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    {
      "type": "select", "id": "columns", "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "info": "Customize filters with the Shopify Search & Discovery app.", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ]
}
{% endschema %}

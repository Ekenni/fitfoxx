<section class="section list-collections" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ shop.name }}</p>
        <h1 class="display">{{ section.settings.heading }}</h1>
      </div>
    </div>
    {%- paginate collections by 24 -%}
      <div class="categories__grid categories__grid--list">
        {%- for collection in collections -%}
          <a href="{{ collection.url }}" class="category reveal">
            <div class="category__media">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 700, 1000', alt: collection.title }}
              {%- else -%}
                {%- render 'placeholder', label: collection.title -%}
              {%- endif -%}
            </div>
            <div class="category__body">
              <span class="category__index">{{ collection.products_count }}</span>
              <h2 class="category__title">{{ collection.title }}</h2>
              <span class="category__cta">{{ 'general.shop' | t }} {% render 'icon', icon: 'arrow-up-right' %}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}

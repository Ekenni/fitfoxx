{%- assign s = section.settings -%}
<section class="section editorial editorial--{{ s.align }}" {{ section.shopify_attributes }}>
  <div class="editorial__frame page-width">
    <div class="editorial__media">
      {%- if s.image != blank -%}
        <picture>
          {%- if s.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
          {%- endif -%}
          {{ s.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000', class: 'editorial__img', alt: s.image.alt }}
        </picture>
      {%- else -%}
        {%- if settings.use_sample_images -%}
          {%- render 'default-image', name: 'foxx-editorial.jpg', width: 2000, height: 1328, class: 'editorial__img', alt: 'Athlete in a sports bra' -%}
        {%- else -%}
          {%- render 'placeholder', label: 'Editorial image' -%}
        {%- endif -%}
      {%- endif -%}
      {%- if s.tag_text != blank -%}<span class="editorial__tag">{{ s.tag_text }}</span>{%- endif -%}
    </div>
    <div class="editorial__panel reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="editorial__heading h1">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="editorial__text rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.code != blank -%}
        <div class="promo-code">
          <span class="promo-code__label">{{ 'sections.editorial.code_label' | t }}</span>
          <code class="promo-code__value">{{ s.code }}</code>
          <button type="button" class="promo-code__copy" data-copy="{{ s.code | escape }}">
            {%- render 'icon', icon: 'copy' -%}<span data-copy-label>{{ 'sections.editorial.copy' | t }}</span>
          </button>
        </div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ s.button_label }} {% render 'icon', icon: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial banner",
  "class": "section-editorial",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2000 x 1100 px recommended" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "tag_text", "label": "Image tag", "default": "Limited drop" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "05 — Off-season sale" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Train harder. Pay less." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Up to 30% off selected training essentials. While stock lasts.</p>" },
    { "type": "text", "id": "code", "label": "Discount code", "info": "Optional. Shoppers can copy it with one tap. Create the code in Shopify Admin > Discounts.", "default": "FOXX30" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the sale" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "align", "label": "Panel position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    }
  ],
  "presets": [{ "name": "Editorial banner" }]
}
{% endschema %}

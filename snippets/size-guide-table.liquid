{%- comment -%} Default FOXX size chart (inches). Replace by selecting a page in the product section. {%- endcomment -%}
<p>{{ 'products.size_guide.intro' | t }}</p>
<div class="table-wrap">
  <table class="size-table">
    <thead>
      <tr><th>{{ 'products.size_guide.size' | t }}</th><th>{{ 'products.size_guide.chest' | t }}</th><th>{{ 'products.size_guide.waist' | t }}</th><th>{{ 'products.size_guide.hips' | t }}</th></tr>
    </thead>
    <tbody>
      <tr><td>XS</td><td>32–34</td><td>26–28</td><td>33–35</td></tr>
      <tr><td>S</td><td>34–36</td><td>28–30</td><td>35–37</td></tr>
      <tr><td>M</td><td>37–40</td><td>31–33</td><td>38–40</td></tr>
      <tr><td>L</td><td>41–44</td><td>34–36</td><td>41–43</td></tr>
      <tr><td>XL</td><td>45–48</td><td>37–40</td><td>44–46</td></tr>
      <tr><td>XXL</td><td>49–52</td><td>41–44</td><td>47–49</td></tr>
    </tbody>
  </table>
</div>
<p class="size-table__note">{{ 'products.size_guide.note' | t }}</p>

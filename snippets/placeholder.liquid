{%- comment -%}
  Plain dark placeholder shown until an image is uploaded.
  Accepts: label (string, optional), class (string, optional)
{%- endcomment -%}
<div class="placeholder{% if class %} {{ class }}{% endif %}" aria-hidden="true">
  {%- render 'icon-fox', class: 'placeholder__mark' -%}
  {%- if label != blank -%}<span class="placeholder__label">{{ label }}</span>{%- endif -%}
</div>

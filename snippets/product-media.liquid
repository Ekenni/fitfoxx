{%- comment -%} Accepts: media (media), loading (string), zoom (boolean) {%- endcomment -%}
{%- case media.media_type -%}
  {%- when 'image' -%}
    {%- if zoom -%}<a href="{{ media | image_url: width: 2400 }}" class="gallery__zoom" target="_blank" rel="noopener" aria-label="{{ 'products.product.open_image' | t }}">{%- endif -%}
    <div class="ratio" style="--ratio: {{ media.aspect_ratio | default: 0.8 }}">
      {{ media | image_url: width: 1600 | image_tag: loading: loading, sizes: '(min-width: 990px) 55vw, 100vw', widths: '500, 750, 1000, 1300, 1600', alt: media.alt }}
    </div>
    {%- if zoom -%}</a>{%- endif -%}
  {%- when 'video' -%}
    <div class="ratio" style="--ratio: {{ media.aspect_ratio | default: 0.8 }}">
      {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1200x' }}
    </div>
  {%- when 'external_video' -%}
    <div class="ratio" style="--ratio: {{ media.aspect_ratio | default: 1.77 }}">
      {{ media | external_video_tag }}
    </div>
  {%- when 'model' -%}
    <div class="ratio" style="--ratio: 1">
      {{ media | model_viewer_tag }}
    </div>
{%- endcase -%}

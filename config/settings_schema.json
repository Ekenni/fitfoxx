[
  {
    "name": "theme_info",
    "theme_name": "FitFoxx Athletics",
    "theme_version": "1.0.0",
    "theme_author": "FitFoxx Athletics",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "paragraph",
        "content": "By default the header shows the white FOXX fox mark and wordmark. Upload a logo below to replace it. The header and footer sections each have their own width controls."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, 64 x 64 px recommended"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Dark base"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background (matte black)",
        "default": "#0B0B0B"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (charcoal)",
        "default": "#161616"
      },
      {
        "type": "color",
        "id": "color_surface_alt",
        "label": "Surface raised",
        "default": "#232323"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text (off-white)",
        "default": "#F2F1EC"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text",
        "default": "#8E8E89"
      },
      {
        "type": "header",
        "content": "Light sections"
      },
      {
        "type": "color",
        "id": "color_light_background",
        "label": "Light background",
        "default": "#ECEBE6"
      },
      {
        "type": "color",
        "id": "color_light_text",
        "label": "Light section text",
        "default": "#0B0B0B"
      },
      {
        "type": "header",
        "content": "Accent"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "info": "Used sparingly: badges, focus states, small highlights.",
        "default": "#54D6A0"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on accent",
        "default": "#0B0B0B"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "montserrat_n8"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size",
        "min": 70,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "Heading letter spacing",
        "min": -60,
        "max": 60,
        "step": 5,
        "unit": "em",
        "info": "Thousandths of an em",
        "default": -20
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "Uppercase headings",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body text size",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & style",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_sample_images",
        "label": "Show FOXX sample photos until you upload your own",
        "info": "Applies to the hero, categories, brand statement and editorial banner. Uncheck to show plain dark placeholders instead.",
        "default": true
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1100,
        "max": 1800,
        "step": 50,
        "unit": "px",
        "default": 1520
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "button_notch",
        "label": "Angled button corners",
        "info": "Cuts a small fox-ear style notch into buttons.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Reveal animations on scroll",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "portrait", "label": "Portrait (4:5)" },
          { "value": "tall", "label": "Tall (2:3)" },
          { "value": "square", "label": "Square" }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_color_count",
        "label": "Show number of colors",
        "default": true
      },
      {
        "type": "header",
        "content": "Badges"
      },
      {
        "type": "paragraph",
        "content": "Badges are driven by product tags. Add the tag below to a product in Shopify Admin to show the badge."
      },
      {
        "type": "checkbox",
        "id": "badges_enabled",
        "label": "Show badges",
        "default": true
      },
      {
        "type": "text",
        "id": "badge_new_tag",
        "label": "New badge tag",
        "default": "new"
      },
      {
        "type": "text",
        "id": "badge_bestseller_tag",
        "label": "Best Seller badge tag",
        "default": "best-seller"
      },
      {
        "type": "checkbox",
        "id": "badge_show_sale",
        "label": "Show Sale badge for discounted products",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order notes",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_free_shipping_text",
        "label": "Cart reassurance text",
        "default": "Free shipping on orders over $75. Free 30-day returns."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/fitfoxx"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@fitfoxx"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter)"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      }
    ]
  }
]
